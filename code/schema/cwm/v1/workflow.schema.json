{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w6w.io/schemas/cwm/v1/workflow.schema.json",
  "title": "Canonical Workflow Model (CWM) v1",
  "description": "Engine-neutral declarative schema for Tier 1 workflow definitions",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "roles", "stages"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["w6w/v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["Workflow"]
    },
    "metadata": {
      "type": "object",
      "required": ["key", "version", "owner", "dataClassification"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "tier": {
          "type": "integer",
          "enum": [1]
        },
        "owner": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Traceability back to originating blueprint or specification, e.g. blueprint:BP-1766322:RefundProcessing"
        },
        "description": {
          "type": "string"
        },
        "dataClassification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "description": "Relative path to the JSON Schema file defining the instance data model"
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["id", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "alternate": {
          "type": "boolean",
          "default": false
        },
        "resolution": {
          "type": "string",
          "description": "Terminal status if this stage concludes the workflow, e.g. Approved, Denied, Resolved"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "userTask",
            "approval",
            "serviceTask",
            "decision",
            "parallel",
            "subStage",
            "waitEvent",
            "timer",
            "childWorkflow",
            "end"
          ]
        },
        "assignee": {
          "$ref": "#/$defs/assignee"
        },
        "form": {
          "type": "string",
          "description": "Path to form JSON schema"
        },
        "action": {
          "type": "string",
          "description": "Registered action name for serviceTask, e.g. refund.initiateTransaction"
        },
        "childWorkflowKey": {
          "type": "string",
          "description": "Key of child workflow for childWorkflow step type"
        },
        "childWorkflowDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Tier 1 permits at most one child-workflow level"
        },
        "subStage": {
          "type": "string",
          "description": "Substage key; reserved for a future compiler/runtime implementation"
        },
        "decision": {
          "type": "string",
          "description": "Path to DMN decision table file"
        },
        "sla": {
          "$ref": "#/$defs/sla"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(next|stage:[a-z0-9-]+|end:[A-Za-z0-9_-]+)$"
          }
        },
        "onError": {
          "type": "object",
          "properties": {
            "retries": {
              "type": "integer",
              "default": 3
            },
            "backoff": {
              "type": "string",
              "default": "PT1M"
            },
            "onFailure": {
              "type": "string",
              "pattern": "^(fail|stage:[a-z0-9-]+|deadLetter)$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assignee": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "lookup": {
          "type": "string",
          "description": "Name of registered directory lookup handler, e.g. lookup:managerOfRequester"
        }
      },
      "additionalProperties": false
    },
    "sla": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "pattern": "^P.*"
        },
        "deadline": {
          "type": "string",
          "pattern": "^P.*"
        },
        "onGoal": {
          "type": "string"
        },
        "onDeadline": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "exists"]
        },
        "value": {},
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "or": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    }
  }
}
